\":{\"lat\":\"45.90388\",\"long\":\"5.97567\"},\"additionalInfo\":[\"Morada :\\n1046 CH DU MOULINET\\n74150 Hauteville Sur Fier\",\"Tipo de área : Área numa quinta\",\"Abertura : 01/01 : 31/12\",\"Praias / Zona balnear Contacto : CAVAZZA GILLES , Tel. : 06 25 87 21 48\"]}},{\"href\":\"/aire_camping_car_gps.php/8265-Aire Du Sud\",\"title\":\"Aire Du Sud\",\"number\":\"(n°8265)\",\"locationInfo\":[\"avenue du sud - à proximité du camping du sud\",\"50590 Hauteville sur mer\"],\"details\":{\"title\":\"Aire Du Sud\",\"imageAlts\":[\"Ligação eléctrica\",\"Água\",\"Estacionamento\",\"Despejos Cassete Química\",\"Despejos Água Negra\",\"Despejos Água Cinzenta\"],\"coordinates\":{\"lat\":\"48.97013\",\"long\":\"-1.55539\"},\"additionalInfo\":[\"Morada :\\navenue du sud - à proximité du camping du sud\\n50590 Hauteville Sur Mer\",\"Tipo de área : Área municipal\",\"Praias / Zona balnear\",\"Ainda não foram relatados locais para visitar perto desta área.\"]}},{\"href\":\"/aire_camping_car_gps.php/1532-Hede\",\"title\":\"Hede\",\"number\":\"(n°1532)\",\"locationInfo\":[\"Sortie Hédé sur la route de Rennes-St Malo (environ 21Klms de Rennes), puis suivre le canal des 11 Ecluses\",\"35000 Hede\"],\"details\":{\"title\":\"Hede\",\"imageAlts\":[\"Estacionamento\"],\"coordinates\":{\"lat\":\"48.29695\",\"long\":\"-1.79962\"},\"additionalInfo\":[\"Morada :\\nSortie Hédé sur la route de Rennes-St Malo (environ 21Klms de Rennes), puis suivre le canal des 11 Ecluses\\n35000 Hede\",\"Tipo de área : Área municipal\",\"Contacto : lerable , Tel. : 0299454767\",\"Ainda não foram relatados locais para visitar perto desta área.\"]}},{\"href\":\"/aire_camping_car_gps.php/31737-Camping Les Etangs Du Plateau Des Landes\",\"title\":\"Camping Les Etangs Du Plateau Des Landes\",\"number\":\"(n°31737)\",\"locationInfo\":[\"8 Rue du Parfum des Sapins\",\"62570 Helfaut\"],\"details\":{\"title\":\"Camping Les Etangs Du Plateau Des Landes\",\"imageAlts\":[\"Ligação eléctrica\",\"Água\",\"Estacionamento\",\"Despejos Água Negra\",\"Despejos Água Cinzenta\"],\"fontText\":\"Nous vous accueillons du 1er avril au 31 octobre dans un cadre champêtre et familial pour faire de votre séjour, un souvenir inoubliable. Vous pourrez séjourner dans notre camping en amoureux, en famille, ou entre amis et passer un moment savoureux en dégustant notre cuisine du terroir, mettant à l’honneur nos artisans locaux. Nous vous proposerons des animations à thème chaque week-end afin de vous offrir un moment de convivialité au BAR du camping. Le camping \\\"les étangs du plateau des Landes\\\" est aussi l’endroit incontournable de nos amis les pêcheurs ! Pour cela, nous avons choisi de réhabiliter nos 10 étangs afin de mettre en place la pêche au blanc, à la carpe et à la truite.( Les étangs sont ouverts du 15 avril au 15 octobre).\\\"\",\"coordinates\":{\"lat\":\"2.26751\",\"long\":\"50.705\"},\"additionalInfo\":[\"Morada :\\n8 Rue du Parfum des Sapins\\n62570 Helfaut\",\"Tipo de área : Área privada\",\"Abertura : 01/04 : 31/10\",\"Contacto : Tatiana Têtu , Tel. : 03 91 93 11 81\",\"Ainda não foram relatados locais para visitar perto desta área.\"]}},{\"href\":\"/aire_camping_car_gps.php/1389-Hennebont\",\"title\":\"Hennebont\",\"number\":\"(n°1389)\",\"locationInfo\":[\"8km ne de Lorient, contourner le haras national et par un chemin, rejoindre les bords du blavet\",\"56000 Hennebont\"],\"details\":{\"title\":\"Hennebont\",\"imageAlts\":[\"Estacionamento\"],\"coordinates\":{\"lat\":\"47.80018\",\"long\":\"-3.27755\"},\"additionalInfo\":[\"Morada :\\n8km ne de Lorient, contourner le haras national et par un chemin, rejoindre les bords du blavet\\n56000 Hennebont\",\"Tipo de área : Área Natural\"]}},{\"href\":\"/aire_camping_car_gps.php/4216-Aire De L'étang D'herbignac\",\"title\":\"Aire De L'étang D'herbignac\",\"number\":\"(n°4216)\",\"locationInfo\":[\"44410 Herbignac\"],\"details\":{\"title\":\"Aire De L'étang D'herbignac\",\"imageAlts\":[\"Ligação eléctrica\",\"Água\",\"Estacionamento\"